<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EastwardLibProject Condition="'$(EastwardLibProject)' == ''">$(MSBuildProjectDirectory)/../EastwardLib/EastwardLib.csproj</EastwardLibProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EastwardLibProject)" />
    <EmbeddedResource Include="../main.lua" LogicalName="EastwardModLoader.main.lua" />
    <EmbeddedResource Include="../ewmod.lua" LogicalName="EastwardModLoader.ewmod.lua" />
    <EmbeddedResource Include="../overlay.lua" LogicalName="EastwardModLoader.overlay.lua" />
  </ItemGroup>
</Project>
